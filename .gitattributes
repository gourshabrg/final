# Files that run inside Linux containers must keep LF line endings,
# even when the repo is checked out on Windows.
*.sh     text eol=lf
*.py     text eol=lf
*.sql    text eol=lf
mvnw     text eol=lf
*.cmd    text eol=crlf

# Sample data is checked with a sha256 in its control file, so Git must never change its bytes.
data/samples/** -text
