# Copy this file to .env and set your own values. Never commit .env.

# AES-256 key for Beam and the API: openssl rand -base64 32 (or exactly 32 characters).
LUMI_ENCRYPTION_KEY=replace-with-32-character-key!!!

# Local logins (default airflow/airflow); PostgreSQL applies them only on a new volume.
# POSTGRES_USER=airflow
# POSTGRES_PASSWORD=airflow
# AIRFLOW_ADMIN_USERNAME=airflow
# AIRFLOW_ADMIN_PASSWORD=airflow
# Signs Airflow web sessions: openssl rand -hex 32
# AIRFLOW_WEBSERVER_SECRET_KEY=

# Uncomment both lines if another PostgreSQL already uses port 5432 on your machine.
# POSTGRES_HOST_PORT=5433
# LUMI_WAREHOUSE_JDBC_URL=jdbc:postgresql://localhost:5433/warehouse

# Only needed when the API is not started from the springboot-ingestion-service folder.
# LUMI_LOCAL_DATA_ROOT=../data
# LUMI_LOCAL_CONTROL_FILE_ROOT=../control-files
